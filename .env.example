# Copy to .env and fill in to run the demo live. Tests and the scripted demo
# do NOT need these — they run offline.
#
# Real model keys (one is enough; demo defaults to OpenAI):
#   OPENAI_API_KEY=      # platform.openai.com/api-keys — API billed separately from ChatGPT
#   GEMINI_API_KEY=      # Google AI Studio (aistudio.google.com) — free tier, no card
#
# Field-level encryption key for patient records (Fernet). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, the service generates an ephemeral key per process and warns —
# records then do not survive a restart.
#   SCHEDULER_ENCRYPTION_KEY=
#
# Optional overrides:
#   SCHEDULER_DB_PATH=scheduler.db
#   SCHEDULER_API_PORT=8000
#   SCHEDULER_API_URL=http://127.0.0.1:8000
#
# Durable database (hosted, Turso free tier — no card). Required on
# Render's free tier: its filesystem is wiped on every spin-down,
# restart and redeploy, so a local scheduler.db loses every booking.
# With these set, the service uses the hosted database instead and
# bookings survive restarts. Without them it uses the local file
# (fine for local runs and tests).
#   SCHEDULER_DATABASE_URL=libsql://<your-db>-<your-org>.turso.io
#   SCHEDULER_DATABASE_AUTH_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=
SCHEDULER_ENCRYPTION_KEY=
